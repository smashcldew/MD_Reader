{
  "name": "md-reader",
  "productName": "MD 閱讀器",
  "version": "1.0.0",
  "description": "預設唯讀的 Markdown 閱讀器，支援資料夾檔案樹",
  "main": "main.js",
  "author": "Cldew",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "dependencies": {
    "dompurify": "3.2.6",
    "marked": "12.0.2"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.cldew.mdreader",
    "productName": "MD 閱讀器",
    "files": ["main.js", "preload.js", "renderer/**/*", "node_modules/marked/**/*", "node_modules/dompurify/**/*"],
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "MD-Reader-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "MD-Reader-Portable-${version}.exe"
    },
    "fileAssociations": [
      { "ext": ["md", "markdown"], "name": "Markdown 文件", "role": "Viewer" }
    ]
  }
}
